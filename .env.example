# Local development only. Never put a wallet seed phrase or private key here.
PORT=4318
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Optional: an OpenAI-compatible chat completion endpoint, kept on the server.
# The app works without it; the Copilot then remains disabled.
AI_API_BASE=
AI_API_KEY=
AI_MODEL=

# Optional, after you deploy and verify the testnet factory from the Treasury page.
ROBINHOOD_SPLIT_FACTORY_ADDRESS=
