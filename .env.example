# Local server configuration. Never add a wallet seed phrase or signing key.
PORT=4318
APP_ORIGIN=http://127.0.0.1:4318
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional server-only OpenAI-compatible provider.
AI_API_BASE=
AI_API_KEY=
AI_MODEL=
# Optional. Defaults to data/robinhood-mainnet-pons-v2.
# DATA_DIRECTORY=
# Optional server-only X OAuth 2.0 confidential-client integration.
# Register APP_ORIGIN + /api/social/x/callback as the exact callback in X.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Base64-encoded 32 random bytes; keep stable to decrypt stored account tokens.
SOCIAL_ENCRYPTION_KEY=
